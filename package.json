{
  "name": "birdepy_project",
  "version": "0.0.0-semantically-released",
  "description": "BirDePy is a Python package for working with continuous time birth-and-death processes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdepy/birdepy_project.git"
  },
  "license": "GPLv3",
  "bugs": {
    "url": "https://github.com/birdepy/birdepy_project/issues"
  },
  "homepage": "https://github.com/birdepy/birdepy_project#readme",
  "devDependencies": {
    "semantic-release": "^25.0.9",
    "semantic-release-pypi": "^5.3.0"
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "master",
      "main",
      "next",
      "next-major",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "semantic-release-pypi",
        {
          "envDir": false,
          "installDeps": false
        }
      ],
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false,
          "failTitle": false,
          "releasedLabels": false
        }
      ]
    ]
  },
  "private": true,
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "check:release": "node .github/scripts/check-release.mjs"
  }
}
